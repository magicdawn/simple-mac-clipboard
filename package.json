{
  "name": "simple-mac-clipboard",
  "type": "module",
  "version": "2.2.1",
  "packageManager": "pnpm@12.8.2",
  "description": "simple mac clipboard for node & electron",
  "author": "magicdawn",
  "license": "MIT",
  "homepage": "https://github.com/magicdawn/simple-mac-clipboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicdawn/simple-mac-clipboard.git"
  },
  "bugs": {
    "url": "https://github.com/magicdawn/simple-mac-clipboard/issues"
  },
  "keywords": [
    "clip",
    "clipboard",
    "mac-clipboard"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./build/*": "./build/*",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "simple_mac_clipboard.node"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "dev:generate-compile_commands": "bear -- node-gyp rebuild",
    "build:addon": "node-gyp rebuild",
    "build:fat-addon": "tsx ./scripts/build-universal-addon.ts",
    "build:tsdown": "tsdown",
    "build": "conc pnpm:build:addon pnpm:build:tsdown",
    "test": "vitest --run --fileParallelism=false",
    "prepublishOnly": "pnpm build:fat-addon && pnpm build:tsdown && pnpm test",
    "test-with-debug": "pnpm build:addon --debug && pnpm test",
    "test-cover": "pnpm test -- --coverage",
    "install": "node ./dist/index.js >/dev/null 2>&1 || npm run build:addon"
  },
  "dependencies": {
    "bindings": "^1.5.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0"
  },
  "devDependencies": {
    "@magicdawn/eslint-config": "^1.6.18",
    "@magicdawn/prettier-config": "^0.1.0",
    "@types/bindings": "^1.5.5",
    "@types/node": "^26.6.4",
    "codecov": "^3.8.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "execa": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "node-abi": "^4.35.0",
    "nyc": "^18.0.0",
    "prebuild": "^13.0.1",
    "prettier": "^3.9.9",
    "semver": "^7.8.5",
    "tsd": "^0.33.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,less,vue}": [
      "prettier --write",
      "git add"
    ],
    "*.{?(c|m)(j|t)s?(x),json,y?(a)ml}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!*.{?(c|m)(j|t)s?(x),json,y?(a)ml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "gypfile": false,
  "directories": {
    "test": "test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
